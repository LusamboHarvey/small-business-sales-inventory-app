
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/txtCartProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Product name"
        android:textColor="#222222"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCartMinus"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtCartProductPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="ZMW 0.00 each"
        android:textColor="#66736B"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/txtCartProductName"
        app:layout_constraintEnd_toStartOf="@id/btnCartMinus"
        app:layout_constraintTop_toBottomOf="@id/txtCartProductName" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCartMinus"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="−"
        android:textColor="#176B38"
        android:textSize="18sp"
        app:backgroundTint="#E4EFE7"
        app:cornerRadius="17dp"
        app:layout_constraintEnd_toStartOf="@id/txtCartQuantity"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtCartQuantity"
        android:layout_width="32dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="1"
        android:textColor="#222222"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/btnCartMinus"
        app:layout_constraintEnd_toStartOf="@id/btnCartPlus"
        app:layout_constraintTop_toTopOf="@id/btnCartMinus"
        app:layout_constraintBottom_toBottomOf="@id/btnCartMinus" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCartPlus"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:backgroundTint="#198754"
        app:cornerRadius="17dp"
        app:layout_constraintEnd_toStartOf="@id/txtCartLineTotal"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtCartLineTotal"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:gravity="end|center_vertical"
        android:text="ZMW 0.00"
        android:textColor="#222222"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

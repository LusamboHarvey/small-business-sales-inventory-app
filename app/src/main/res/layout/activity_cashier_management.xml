
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F5"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtCashierManagementTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cashier Management"
        android:textColor="#183D2B"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtCashierManagementSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Create and manage cashier accounts."
        android:textColor="#66736B"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/txtCashierManagementTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddCashier"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text=" +  Create Cashier Account"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:backgroundTint="#23834B"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtCashierManagementSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtCashierListHeading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Cashier Accounts"
        android:textColor="#183D2B"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnAddCashier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtCashierListPlaceholder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:padding="18dp"
        android:text="Cashier accounts will appear here."
        android:textColor="#66736B"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/txtCashierListHeading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

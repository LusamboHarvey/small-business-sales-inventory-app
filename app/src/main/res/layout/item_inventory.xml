<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:background="#F8F9F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgInventoryProduct"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:contentDescription="Product image"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="#E0E0E0" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtInventoryName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textColor="#212121"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInventorySku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SKU: Not assigned"
                android:textColor="#616161"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtInventoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="In Stock"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:textSize="12sp"
            android:padding="8dp"
            android:background="#E8F5E9" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtInventoryCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textColor="#616161"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtInventoryStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stock: 0"
        android:textColor="#1B5E20"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnStockIn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stock In"
            android:textColor="#1B5E20"
            android:backgroundTint="#E8F5E9" />

        <Button
            android:id="@+id/btnStockOut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Stock Out"
            android:textColor="#E65100"
            android:backgroundTint="#FFF3E0" />

    </LinearLayout>

</LinearLayout>
